# ─────────────────────────────────────────────────────────────────────────────
# 이 파일을 복사해서 `.env.local` 로 만들고 값을 채우세요.
#   cp .env.local.example .env.local
#
# .env.local 과 서비스 계정 JSON 은 절대 커밋하지 마세요.
# (.gitignore 에 .env* 가 이미 들어 있습니다)
# ─────────────────────────────────────────────────────────────────────────────

# ── 웹 앱 설정 ──────────────────────────────────────────────────────────────
# Firebase Console → 프로젝트 설정 → 내 앱 → 웹 앱(</>) → firebaseConfig
# NEXT_PUBLIC_ 접두사는 브라우저로 나갑니다. 원래 공개되는 값이라 괜찮습니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 서버 전용 (Admin SDK) ───────────────────────────────────────────────────
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → JSON 다운로드
# 그 JSON 안의 세 값입니다. private_key 는 줄바꿈이 \n 으로 들어 있는데
# 그대로 큰따옴표로 감싸서 붙여넣으면 됩니다.
# 이 값들은 브라우저로 나가지 않습니다. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ── 젯슨 게이트 인증 ────────────────────────────────────────────────────────
# 게이트마다 발급하는 기기 키. 상하 님께 전달할 값입니다.
# 아무 긴 랜덤 문자열이면 됩니다. 예: openssl rand -hex 32
GATE_DEVICE_KEY_B2=
